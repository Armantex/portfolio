---
// component import
import MainHead from "./MainHead.astro";
import Footer from "@body/footer.astro";
import Header from "@body/header.astro";

// style import
import "@/styles/globals.css";
import "@/styles/local.css";

const {
  title = "My Astro Blog",
  description = "My musings about the Astro framework",
} = Astro.props;
---

<html lang="en">
  <MainHead {title} {description} />
  <body class="montserrat-normal">
    <Header />
    <slot />
    <Footer />
  </body>
</html>
