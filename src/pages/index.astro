---
import Con1 from "@body/con1.astro";
import Con2 from "@body/con3.astro";
import Con3 from "@body/con3.astro";
import Info from "@body/info.astro";

import MainHtml from "@layouts/MainHtml.astro";
---

<MainHtml>
  <section
    id="cube"
    class="absolute grid grid-rows-6 grid-cols-5 gap-4
      w-[92%] h-[86%] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2"
  >
    <Info class="order-1 row-span-4 col-span-3 rounded-xl" />
    <Con1 class="order-2 row-span-3 col-span-2 rounded-xl" />
    <Con2 class="order-4 row-span-2 col-span-3 rounded-xl" />
    <Con3 class="order-3 row-span-3 col-span-2 rounded-xl" />
  </section>
</MainHtml>
